# Configuración de Django
SECRET_KEY=your-very-long-and-random-secret-key-here-at-least-50-characters
DEBUG=False
ALLOWED_HOSTS=localhost,yourdomain.com,www.yourdomain.com

# Configuración de Base de Datos
POSTGRES_DB=lakultural
POSTGRES_USER=lakultural_user
POSTGRES_PASSWORD=your-secure-database-password
PGDATABASE=lakultural
PGUSER=lakultural_user
PGPASSWORD=your-secure-database-password
PGHOST=db
PGPORT=5432

# Configuración de Email
EMAIL_HOST=smtp.ionos.es
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=contacto@yourdomain.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=contacto@yourdomain.com

# Configuración de DigitalOcean Spaces (opcional)
DIGITAL_OCEAN_KEY_ID=your-digital-ocean-key-id
DIGITAL_OCEAN_API_KEY=your-digital-ocean-api-key
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_S3_ENDPOINT_URL=https://fra1.digitaloceanspaces.com

# Configuración de PayPal
PAYPAL_TEST=True
PAYPAL_RECEIVER_EMAIL=your-paypal-email@domain.com
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_SECRET_KEY=your-paypal-secret-key

# Configuración de Entorno
ENVIRONMENT=production
